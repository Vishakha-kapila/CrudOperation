@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
    Layout = null;   // 🔥 Full screen design (no navbar)
}

<style>
    body {
        margin: 0;
        padding: 0;
        font-family: 'Segoe UI', sans-serif;
        background: linear-gradient(135deg, #667eea, #764ba2);
        height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .login-box {
        background: rgba(255, 255, 255, 0.15);
        backdrop-filter: blur(20px);
        padding: 40px;
        border-radius: 20px;
        width: 350px;
        box-shadow: 0 10px 40px rgba(0,0,0,0.3);
        text-align: center;
        color: white;
        animation: fadeIn 1s ease-in-out;
    }

    h2 {
        margin-bottom: 20px;
    }

    .form-control {
        border-radius: 25px;
        padding: 12px;
        border: none;
        margin-bottom: 15px;
    }

    .btn-login {
        width: 100%;
        padding: 12px;
        border-radius: 25px;
        border: none;
        background: white;
        color: #764ba2;
        font-weight: bold;
        transition: 0.3s;
    }

        .btn-login:hover {
            background: #eee;
            transform: scale(1.05);
        }

    a {
        color: #fff;
        font-size: 14px;
        text-decoration: none;
    }

        a:hover {
            text-decoration: underline;
        }

    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(40px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }
</style>

<div class="login-box">
    <h2>🔐 Login</h2>

    <form method="post">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        <input asp-for="Input.Email" class="form-control" placeholder="📧 Email" />
        <span asp-validation-for="Input.Email" class="text-danger"></span>

        <input asp-for="Input.Password" type="password" class="form-control" placeholder="🔑 Password" />
        <span asp-validation-for="Input.Password" class="text-danger"></span>

        <div style="margin-bottom:10px;">
            <input asp-for="Input.RememberMe" />
            <label asp-for="Input.RememberMe">Remember Me</label>
        </div>

        <button type="submit" class="btn-login">Log in</button>

        <div style="margin-top:15px;">
            <a asp-page="./ForgotPassword">Forgot Password?</a><br />
            <a asp-page="./Register">Create Account</a>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}