<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">

    <!-- ✅ Fixed viewport -->
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>@ViewData["Title"] - Project</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <!-- jQuery -->
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>

    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    <style>
        html, body {
            height: 100%;
        }

        body {
            display: flex;
            flex-direction: column;
        }

        main {
            flex: 1;
            margin: 0;
            padding: 0;
        }

        footer {
            background-color: #333;
            color: white;
            text-align: center;
            padding: 10px 0;
        }

        .navbar {
            background: linear-gradient(to right, #141e30, #243b55);
        }

        .nav-link {
            transition: 0.3s;
            font-weight: 500;
        }

            .nav-link:hover {
                color: #ffc107 !important;
                transform: translateY(-2px);
            }

        .navbar-brand {
            letter-spacing: 1px;
        }
    </style>

</head>

<body>

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark shadow">
        <div class="container">

            <!-- Brand -->
            <a class="navbar-brand fw-bold fs-4" href="@Url.Action("Index", "Home")">
                🚀 Project
            </a>

            <!-- Toggler Button -->
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>

            <!-- Navbar Links -->
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav ms-auto align-items-center">

    <li class="nav-item mx-2">
        <a class="nav-link btn btn-outline-primary px-3"
           href="@Url.Action("Index", "Employee")">
            Home
        </a>
    </li>

    <li class="nav-item mx-2">
        <a class="nav-link btn btn-outline-secondary px-3"
           href="@Url.Action("Salary", "Employee")">
            Salary
        </a>
    </li>

</ul>
              
                </ul>
                <!-- Right Side (Login/Register) -->
                <div class="d-flex align-items-center">
                    <partial name="_LoginPartial" />
                </div>

            </div>
        </div>
    </nav>

    <!-- Main Content -->
    <main class="container-fluid p-0 mt-4">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer>
        <p class="mb-0">
            © 2026 Project |
            <a href="mailto:hege@example.com"
               class="text-white text-decoration-none">
                hege@example.com
            </a>
        </p>
    </footer>

    @RenderSection("scripts", required: false)

</body>
</html>